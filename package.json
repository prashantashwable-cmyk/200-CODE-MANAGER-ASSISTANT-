{
  "name": "aiec-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ALL INDIA ELEVATORS COMPANY (AIEC) — mobile-first, multi-role elevator business platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:keys": "node scripts/check-translations.mjs",
    "translations": "node scripts/check-translations.mjs",
    "guard": "node scripts/no-mock-guard.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:server": "playwright test --config playwright.server.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@supabase/supabase-js": "^2.117.3",
    "i18next": "^23.16.8",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/leaflet": "^1.9.22",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pg": "^8.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "tesseract.js@7.0.0": true
  }
}
